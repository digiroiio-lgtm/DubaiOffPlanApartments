# Public site URL used for canonical URLs and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.dubaioffplanapartments.com
# WhatsApp number for "Talk to an advisor" (digits only, with country code). Empty -> links to /contact/
NEXT_PUBLIC_ADVISOR_WHATSAPP=
# Google Analytics 4 measurement ID (optional). Events are always pushed to window.dataLayer.
NEXT_PUBLIC_GA4_ID=
# Show clearly-labelled demo projects (never indexed). Set to "false" in production once verified data exists.
SHOW_DEMO_CONTENT=true
# Lead store (SQLite file). Must be on persistent disk.
LEADS_DB_PATH=./data/leads.sqlite
# Secret used to hash IPs and sign form tokens (min 32 chars)
LEADS_SECRET=change-me-to-a-long-random-string-0123456789
# Internal lead list (/admin/leads) basic auth. Admin is disabled if unset.
ADMIN_USERNAME=
ADMIN_PASSWORD=
